# 统一 LF —— .sh 用 CRLF 会在容器里直接跑不起来
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
Dockerfile        text eol=lf
.dockerignore     text eol=lf
.env.example      text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.zip   binary
*.exe   binary
*.dll   binary
